{
  "info": {
    "name": "Student Fee Management API",
    "description": "baseUrl: http://localhost:8081 when running with Docker (default), http://localhost:8080 when running locally (IDE/Maven). Run folders in order; ids saved automatically. Seeded data: schools 1-2, students 1-4, fees 1-5.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Setup",
      "item": [
        {
          "name": "Create school",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schools"
              ]
            },
            "description": "201; 409 if code exists",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Green Valley School\",\n  \"code\": \"GVS-01\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('schoolId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get school",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/{{schoolId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schools",
                "{{schoolId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students"
              ]
            },
            "description": "201; 404 school; 409 duplicate admission no.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"schoolId\": {{schoolId}},\n  \"name\": \"Ishaan Gupta\",\n  \"admissionNumber\": \"GV-001\",\n  \"grade\": \"4-A\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('studentId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get student",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{studentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{studentId}}"
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "2. Fees",
      "item": [
        {
          "name": "Create fee record",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees"
              ]
            },
            "description": "201; 409 same student+year+type",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"academicYear\": \"2025-26\",\n  \"feeType\": \"TUITION\",\n  \"description\": \"Annual tuition\",\n  \"totalAmount\": 45000.0,\n  \"dueDate\": \"2026-04-30\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) pm.collectionVariables.set('feeId', pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get fee record",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/{{feeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "{{feeId}}"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Student fee details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/students/{{studentId}}/fees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "students",
                "{{studentId}}",
                "fees"
              ]
            },
            "description": "Optional ?status=PENDING|PARTIAL|PAID"
          }
        },
        {
          "name": "Students with pending fees (school filter, paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/pending-students?schoolId=1&page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "pending-students"
              ],
              "query": [
                {
                  "key": "schoolId",
                  "value": "1"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": "Optional academicYear, overdueOnly=true. Sorted by outstanding desc"
          }
        },
        {
          "name": "Pending fees - overdue only, all schools",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/pending-students?overdueOnly=true&page=0&size=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "pending-students"
              ],
              "query": [
                {
                  "key": "overdueOnly",
                  "value": "true"
                },
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "10"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "3. Payments",
      "item": [
        {
          "name": "Record partial payment",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/{{feeId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "{{feeId}}",
                "payments"
              ]
            },
            "description": "201 -> payment + updated fee",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 15000.0,\n  \"mode\": \"UPI\",\n  \"paymentDate\": \"2026-01-10\",\n  \"transactionReference\": \"UPI-{{$timestamp}}\",\n  \"remarks\": \"Installment 1\"\n}"
            }
          }
        },
        {
          "name": "Overpayment (expect 422)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/{{feeId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "{{feeId}}",
                "payments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 9999999.0,\n  \"mode\": \"CASH\"\n}"
            }
          }
        },
        {
          "name": "Duplicate reference (expect 409 on 2nd send)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/{{feeId}}/payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "{{feeId}}",
                "payments"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 100.0,\n  \"mode\": \"CARD\",\n  \"transactionReference\": \"FIXED-REF-1\"\n}"
            }
          }
        },
        {
          "name": "Payment history (paged)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/{{feeId}}/payments?page=0&size=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "{{feeId}}",
                "payments"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "0"
                },
                {
                  "key": "size",
                  "value": "20"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "4. Summary",
      "item": [
        {
          "name": "School fee summary",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/1/fee-summary",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schools",
                "1",
                "fee-summary"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "School fee summary for a year",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/schools/1/fee-summary?academicYear=2025-26",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "schools",
                "1",
                "fee-summary"
              ],
              "query": [
                {
                  "key": "academicYear",
                  "value": "2025-26"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    },
    {
      "name": "5. Error cases",
      "item": [
        {
          "name": "Validation error (400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees"
              ]
            },
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": 1,\n  \"academicYear\": \"2025-27\",\n  \"feeType\": \"\",\n  \"totalAmount\": -1\n}"
            }
          }
        },
        {
          "name": "Unknown fee (404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/999999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "999999"
              ]
            },
            "description": ""
          }
        },
        {
          "name": "Page size too large (400)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/fees/pending-students?size=500",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "fees",
                "pending-students"
              ],
              "query": [
                {
                  "key": "size",
                  "value": "500"
                }
              ]
            },
            "description": ""
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "schoolId",
      "value": "1"
    },
    {
      "key": "studentId",
      "value": "1"
    },
    {
      "key": "feeId",
      "value": "1"
    }
  ]
}